# Valores padrao do instalador. Qualquer um pode ser sobrescrito por variavel
# de ambiente antes de rodar (ex.: K3S_VERSAO=... ./instalar.sh).
K3S_VERSAO="${K3S_VERSAO:-v1.35.5+k3s1}"
FLEET_VERSAO="${FLEET_VERSAO:-0.16.3}"
AWS_REGION="${AWS_REGION:-us-east-1}"
SSM_PREFIXO="${SSM_PREFIXO:-/frota}"
# rancher | fleet  (fleet = central so com Fleet, sem Rancher)
MODO_CENTRAL="${MODO_CENTRAL:-rancher}"
KUBECONFIG="${KUBECONFIG:-/etc/rancher/k3s/k3s.yaml}"
TIMEOUT_REGISTRO="${TIMEOUT_REGISTRO:-600}"
