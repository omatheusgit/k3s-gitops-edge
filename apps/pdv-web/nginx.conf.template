# Processado pelo entrypoint da imagem (envsubst) so com variaveis definidas,
# entao $uri e afins continuam sendo variaveis do nginx.
# Resolver pelo IP do DNS do pod (o entrypoint da imagem preenche
# NGINX_LOCAL_RESOLVERS a partir do /etc/resolv.conf). Com um nome aqui, o
# nginx precisava resolve-lo ao subir, e com ndots:5 a busca passava pelos
# dominios do no, que o CoreDNS manda para a internet: sem internet, SERVFAIL,
# e o nginx morria com "host not found" (achado pelo e2e sem internet).
resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;

server {
    listen 8080;
    server_tokens off;
    root /usr/share/nginx/html;

    location = /saude {
        access_log off;
        return 200 "ok\n";
    }

    # Unica rota do Meilisearch exposta ao navegador: pesquisa em indices
    # conhecidos. A chave fica aqui no servidor; o Traefik exige JWT antes.
    location ~ ^/busca/indexes/(produtos|vendas)/search$ {
        limit_except POST { deny all; }
        set $busca http://busca.loja.svc.cluster.local:7700;
        rewrite ^/busca(/.*)$ $1 break;
        # So a chave de busca, derivada pelo initContainer (pdv-web.yaml).
        include /etc/nginx/chave/busca.conf;
        proxy_pass $busca;
    }

    location /busca/ {
        return 404;
    }

    location / {
        try_files $uri /index.html;
    }
}
